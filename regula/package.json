{
  "name": "regula",
  "private": true,
  "version": "0.1.0",
  "description": "Regula, the Finnova AI Cockpit desktop pet (POC)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "start:mock": "tauri dev -- -- --mock",
    "typecheck": "tsc --noEmit",
    "poses": "node scripts/pose-sheet.mjs",
    "test": "esbuild tests/state.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/state.test.mjs --log-level=warning && node node_modules/.cache/state.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-window-state": "^2.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
